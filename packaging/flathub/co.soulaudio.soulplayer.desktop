[Desktop Entry]
# The Flatpak/Flathub copy of the desktop entry. Every other Linux package gets
# this file GENERATED by cargo-packager from `[package.metadata.packager]`, but
# cargo-packager cannot run inside a Flathub build (it is not vendored, and the
# builders have no network), so this one is committed.
#
# `the_flathub_desktop_entry_matches_the_packaged_one` keeps it honest: Name,
# Comment and Categories are compared against the values cargo-packager derives
# from Cargo.toml, so this cannot drift into a second source of truth.
#
# Two fields deliberately differ from the generated entry, because Flatpak
# requires them to: the file is installed as `$FLATPAK_ID.desktop` and `Icon`
# must resolve under the same name, while `Exec` stays the binary's name because
# that is what `command:` runs inside the sandbox.
Type=Application
Name=Soul Player
Comment=Play your music library, gapless, bit-perfect playback
Exec=soul-player
Icon=co.soulaudio.soulplayer
Categories=AudioVideo;Audio;Music;
Terminal=false
