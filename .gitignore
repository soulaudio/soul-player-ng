/target
**/*.rs.bk

# soul-player-host is its own nested cargo workspace (cpal carries in here,
# kept out of the root/headless workspace), so its build output lands in its
# own target/, not the root /target above.
/crates/soul-player-host/target/

# app/rune is its own nested cargo workspace (Rune/wgpu), target/ stays out.
/app/rune/target/

# Updater private signing key — must NEVER be committed. cargo-packager-updater's
# keypair is generated locally; the private key is held as a CI secret, the public
# key is embedded in the app. Keep every private key out of git.
/.signing/
*.key

# Agent / tooling scratch (Claude worktrees, Playwright MCP) — never commit.
/.claude/
/.playwright-mcp/

