/target
**/*.rs.bk

# soul-player-host is its own nested cargo workspace (cpal carries in here,
# kept out of the root/headless workspace), so its build output lands in its
# own target/, not the root /target above.
/crates/soul-player-host/target/

# app/ (the Rune UI head) is its own nested cargo workspace (Rune/wgpu),
# so its target/ stays out.
/app/target/

# alloc-probe is a standalone dev-only crate (its own workspace), path-dep'd by the
# player crates for the counting test allocator; its build output stays out too.
/crates/alloc-probe/target/

# Updater private signing key: must NEVER be committed. cargo-packager-updater's
# keypair is generated locally; the private key is held as a CI secret, the public
# key is embedded in the app. Keep every private key out of git.
/.signing/
*.key
*.key.pub

# Obsolete Tauri-era updater keypair (Tauri was removed). Keep the whole dir out.
/.tauri/

# Agent / tooling scratch (Claude worktrees + skills, Playwright MCP). Never
# commit these.
/.claude/
/.playwright-mcp/

# Internal working notes, kept out of the published repo: agent-written design
# specs and implementation plans, and the UI parity shots taken against the old
# closed-source app. Published design rationale belongs in docs/adr/ instead.
/docs/superpowers/
/docs/ui-reference/

# Python bytecode from the release scripts (.github/scripts/*.py).
__pycache__/
*.pyc

.superpowers/
packaging/deb/generated/

# Generated from app/Cargo.lock by packaging/flathub/generate-sources.sh.
# NOT committed: it is a 440 KB build artifact that would need regenerating on
# every dependency bump, which turned every Dependabot PR into a CI failure.
# It is deterministic from the lockfile (verified: an independent regeneration
# matched byte-for-byte), so generating it when needed loses nothing.
packaging/flathub/cargo-sources.json

# A local soul-server config (library paths, bind address, db location). The
# committed template is soul-server.example.toml.
/soul-server.toml

# website/: dependencies, build output, and the generated files. The three
# under public/ are copied in at build time from their source of truth
# elsewhere in the repo (packaging/install.sh, docs/screenshots/, app/icons/),
# so committing them would just create a second copy that can go stale.
/website/node_modules/
/website/dist/
/website/.astro/
/website/src/data/release.json
/website/public/install.sh
/website/public/screenshot.png
/website/public/favicon.png
